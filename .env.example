# ==========================================================
# RAG environment configuration (copy to `.env` and fill in)
#
#   cp .env.example .env
#
# The system supports three LLM backends. You only need ONE:
#
#   1. Groq (primary by default)
#      - sign up at https://console.groq.com -> create an API key
#   2. OpenRouter (used as a fallback by default)
#      - sign up at https://openrouter.ai -> create an API key
#   3. LM Studio (fully local, no internet / no key)
#      - run a model served at the OpenAI-compatible endpoint below
#
# If no key is present for a provider, that provider is simply skipped
# by the failover logic. If ALL providers are unavailable, the agents
# return a structured "all providers unavailable" result instead of
# guessing.
#
# The intermediate agents (query understanding / answer generation /
# grounding) each read PRINCIPAL_* / FALLBACK_* provider env vars, so you
# can route specific stages to specific models. Every variable below is
# optional; sensible defaults are compiled in.
# ==========================================================

# ---- Groq (fast, free tier) ------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- OpenRouter (broad model catalogue) ------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- LM Studio (local, OpenAI-compatible) -----------------------------
# Uncomment to prefer the local backend:
# LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# ---- Per-stage provider routing (optional) ----------------------------
# These let you pin a specific provider/model per agent stage while keeping
# the above env vars as defaults. Values: groq | openrouter | lmstudio
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=openrouter
ANSWER_LLM_PROVIDER=
ANSWER_LLM_FALLBACK_PROVIDER=
GROUNDING_LLM_PROVIDER=
GROUNDING_LLM_FALLBACK_PROVIDER=

# ---- Vector store (optional overrides) --------------------------------
# Point the system at a specific ChromeDB store without editing code.
PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=data_warehousing

# ---- Flask backend (optional) ------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
